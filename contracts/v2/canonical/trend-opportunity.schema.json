{
  "$defs": {
    "EvidenceGate": {
      "enum": [
        "PASSED",
        "LOW_CONFIDENCE"
      ],
      "title": "EvidenceGate",
      "type": "string"
    },
    "EvidenceRole": {
      "enum": [
        "PRIMARY_WHY_NOW",
        "QUALITATIVE_SIGNAL",
        "QUOTE_PROOF",
        "CONTEXT"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "MediaIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "episode_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Number"
        },
        "episode_title": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Title"
        },
        "media_kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "season_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Number"
        },
        "show_or_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Show Or Title",
          "type": "string"
        }
      },
      "required": [
        "media_kind",
        "show_or_title"
      ],
      "title": "MediaIdentityV2",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "TV_EPISODE",
        "TV_SERIES",
        "FILM",
        "TRAILER",
        "OFFICIAL_CLIP"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "OpportunityFocus": {
      "additionalProperties": false,
      "properties": {
        "characters": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Characters",
          "type": "array"
        },
        "relationship_or_topic": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relationship Or Topic",
          "type": "string"
        }
      },
      "required": [
        "relationship_or_topic"
      ],
      "title": "OpportunityFocus",
      "type": "object"
    },
    "OpportunityQualityScoreV1": {
      "additionalProperties": false,
      "properties": {
        "audience_fit": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Audience Fit",
          "type": "number"
        },
        "evidence_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Quality",
          "type": "number"
        },
        "fandom_velocity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fandom Velocity",
          "type": "number"
        },
        "footage_actionability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Footage Actionability",
          "type": "number"
        },
        "freshness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Freshness",
          "type": "number"
        },
        "intent_fit": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Intent Fit",
          "type": "number"
        },
        "profile_id": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "relationship_or_character_salience": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relationship Or Character Salience",
          "type": "number"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "short_form_edit_potential": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Short Form Edit Potential",
          "type": "number"
        },
        "source_diversity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Diversity",
          "type": "number"
        },
        "total": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Total",
          "type": "number"
        },
        "uncertainty_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Uncertainty Penalty",
          "type": "number"
        },
        "weights": {
          "$ref": "#/$defs/OpportunityRankingWeightsV1"
        }
      },
      "required": [
        "profile_id",
        "intent_fit",
        "audience_fit",
        "freshness",
        "fandom_velocity",
        "short_form_edit_potential",
        "relationship_or_character_salience",
        "footage_actionability",
        "evidence_quality",
        "source_diversity",
        "uncertainty_penalty",
        "weights",
        "total"
      ],
      "title": "OpportunityQualityScoreV1",
      "type": "object"
    },
    "OpportunityRankingWeightsV1": {
      "additionalProperties": false,
      "properties": {
        "audience_fit": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Audience Fit",
          "type": "number"
        },
        "evidence_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Quality",
          "type": "number"
        },
        "fandom_velocity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fandom Velocity",
          "type": "number"
        },
        "footage_actionability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Footage Actionability",
          "type": "number"
        },
        "freshness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Freshness",
          "type": "number"
        },
        "intent_fit": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Intent Fit",
          "type": "number"
        },
        "relationship_or_character_salience": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Relationship Or Character Salience",
          "type": "number"
        },
        "short_form_edit_potential": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Short Form Edit Potential",
          "type": "number"
        },
        "source_diversity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Source Diversity",
          "type": "number"
        },
        "uncertainty_penalty": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Uncertainty Penalty",
          "type": "number"
        }
      },
      "required": [
        "intent_fit",
        "audience_fit",
        "freshness",
        "fandom_velocity",
        "short_form_edit_potential",
        "relationship_or_character_salience",
        "footage_actionability",
        "evidence_quality",
        "source_diversity",
        "uncertainty_penalty"
      ],
      "title": "OpportunityRankingWeightsV1",
      "type": "object"
    },
    "OpportunityScoreV2": {
      "additionalProperties": false,
      "properties": {
        "cross_source_agreement": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cross Source Agreement",
          "type": "number"
        },
        "footage_actionability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Footage Actionability",
          "type": "number"
        },
        "independent_source_count": {
          "maximum": 30,
          "minimum": 0,
          "title": "Independent Source Count",
          "type": "integer"
        },
        "release_freshness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Release Freshness",
          "type": "number"
        },
        "scene_specificity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scene Specificity",
          "type": "number"
        },
        "total": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "release_freshness",
        "cross_source_agreement",
        "scene_specificity",
        "footage_actionability",
        "independent_source_count",
        "total"
      ],
      "title": "OpportunityScoreV2",
      "type": "object"
    },
    "ShortFormEditPotentialV1": {
      "additionalProperties": false,
      "properties": {
        "band": {
          "$ref": "#/$defs/ShortFormPotentialBand"
        },
        "direct_tiktok_data_used": {
          "const": false,
          "default": false,
          "title": "Direct Tiktok Data Used",
          "type": "boolean"
        },
        "disclaimer": {
          "const": "TikTok potential is inferred from cross-platform fandom and editability signals. Direct TikTok trend data was not used.",
          "default": "TikTok potential is inferred from cross-platform fandom and editability signals. Direct TikTok trend data was not used.",
          "title": "Disclaimer",
          "type": "string"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "metric_name": {
          "const": "SHORT_FORM_EDIT_POTENTIAL",
          "default": "SHORT_FORM_EDIT_POTENTIAL",
          "title": "Metric Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signals": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Signals",
          "type": "array"
        },
        "supporting_claim_ids": {
          "items": {
            "format": "uuid4",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Supporting Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "band",
        "explanation",
        "signals",
        "supporting_claim_ids"
      ],
      "title": "ShortFormEditPotentialV1",
      "type": "object"
    },
    "ShortFormPotentialBand": {
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH"
      ],
      "title": "ShortFormPotentialBand",
      "type": "string"
    },
    "TrustedOpportunityEvidenceReferenceV2": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid4",
          "title": "Claim Id",
          "type": "string"
        },
        "independence_group": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Independence Group",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "supports_why_now": {
          "title": "Supports Why Now",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "role",
        "supports_why_now",
        "independence_group"
      ],
      "title": "TrustedOpportunityEvidenceReferenceV2",
      "type": "object"
    }
  },
  "$id": "https://ai-edit-machine.local/contracts/v2/canonical/trend-opportunity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caveats": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Caveats",
      "type": "array"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "creative_hook": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Creative Hook",
      "type": "string"
    },
    "dossier_id": {
      "anyOf": [
        {
          "format": "uuid4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dossier Id"
    },
    "emotional_edit_direction": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Emotional Edit Direction",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/TrustedOpportunityEvidenceReferenceV2"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "evidence_gate": {
      "$ref": "#/$defs/EvidenceGate"
    },
    "focus": {
      "$ref": "#/$defs/OpportunityFocus"
    },
    "footage_request_id": {
      "format": "uuid4",
      "title": "Footage Request Id",
      "type": "string"
    },
    "media_identity": {
      "$ref": "#/$defs/MediaIdentityV2"
    },
    "media_kind": {
      "$ref": "#/$defs/MediaKind"
    },
    "opportunity_id": {
      "format": "uuid4",
      "title": "Opportunity Id",
      "type": "string"
    },
    "quality_score": {
      "anyOf": [
        {
          "$ref": "#/$defs/OpportunityQualityScoreV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "recommended_concept_id": {
      "anyOf": [
        {
          "format": "uuid4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recommended Concept Id"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "$ref": "#/$defs/OpportunityScoreV2"
    },
    "short_form_edit_potential": {
      "anyOf": [
        {
          "$ref": "#/$defs/ShortFormEditPotentialV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "what_viewers_are_discussing": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "What Viewers Are Discussing",
      "type": "string"
    },
    "why_now": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Why Now",
      "type": "string"
    }
  },
  "required": [
    "opportunity_id",
    "footage_request_id",
    "media_kind",
    "media_identity",
    "title",
    "focus",
    "why_now",
    "what_viewers_are_discussing",
    "creative_hook",
    "emotional_edit_direction",
    "evidence",
    "evidence_gate",
    "confidence",
    "score"
  ],
  "title": "TrendOpportunityV2",
  "type": "object"
}
