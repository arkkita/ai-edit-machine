{
  "$defs": {
    "EvidenceGate": {
      "enum": [
        "PASSED",
        "LOW_CONFIDENCE"
      ],
      "title": "EvidenceGate",
      "type": "string"
    },
    "EvidenceRole": {
      "enum": [
        "PRIMARY_WHY_NOW",
        "QUALITATIVE_SIGNAL",
        "QUOTE_PROOF",
        "CONTEXT"
      ],
      "title": "EvidenceRole",
      "type": "string"
    },
    "FootageQuoteStatus": {
      "enum": [
        "VERIFIED",
        "PARAPHRASE",
        "UNVERIFIED_LEAD"
      ],
      "title": "FootageQuoteStatus",
      "type": "string"
    },
    "FootageQuoteV2": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid4",
          "title": "Claim Id",
          "type": "string"
        },
        "likely_context": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likely Context"
        },
        "speaker": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "status": {
          "$ref": "#/$defs/FootageQuoteStatus"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "status",
        "text",
        "claim_id"
      ],
      "title": "FootageQuoteV2",
      "type": "object"
    },
    "FootageRequestV2": {
      "additionalProperties": false,
      "properties": {
        "alternative_sources": {
          "items": {
            "$ref": "#/$defs/RequestedSourceV2"
          },
          "maxItems": 30,
          "title": "Alternative Sources",
          "type": "array"
        },
        "footage_request_id": {
          "format": "uuid4",
          "title": "Footage Request Id",
          "type": "string"
        },
        "intro_leads": {
          "items": {
            "$ref": "#/$defs/IntroMaterialLeadV2"
          },
          "maxItems": 20,
          "title": "Intro Leads",
          "type": "array"
        },
        "minimum_useful_source_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Minimum Useful Source Keys",
          "type": "array"
        },
        "natural_request": {
          "$ref": "#/$defs/NaturalFootageRequestV2"
        },
        "opportunity_id": {
          "format": "uuid4",
          "title": "Opportunity Id",
          "type": "string"
        },
        "optional_sources": {
          "items": {
            "$ref": "#/$defs/RequestedSourceV2"
          },
          "maxItems": 30,
          "title": "Optional Sources",
          "type": "array"
        },
        "required_sources": {
          "items": {
            "$ref": "#/$defs/RequestedSourceV2"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Required Sources",
          "type": "array"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "search_queries": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Search Queries",
          "type": "array"
        },
        "smallest_useful_set_reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Smallest Useful Set Reason",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "warnings": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "footage_request_id",
        "opportunity_id",
        "summary",
        "natural_request",
        "required_sources",
        "minimum_useful_source_keys",
        "smallest_useful_set_reason",
        "search_queries"
      ],
      "title": "FootageRequestV2",
      "type": "object"
    },
    "FootageVerificationLevel": {
      "enum": [
        "VERIFIED",
        "STRONGLY_SUPPORTED",
        "LIKELY_INFERRED",
        "UNKNOWN"
      ],
      "title": "FootageVerificationLevel",
      "type": "string"
    },
    "IntroMaterialLeadV2": {
      "additionalProperties": false,
      "properties": {
        "intro_lead_id": {
          "format": "uuid4",
          "title": "Intro Lead Id",
          "type": "string"
        },
        "moment_description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Moment Description",
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/FootageQuoteV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_key": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Source Key",
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "format": "uuid4",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Supporting Claim Ids",
          "type": "array"
        },
        "verification_level": {
          "$ref": "#/$defs/FootageVerificationLevel"
        },
        "why_it_might_lead_into_montage": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Why It Might Lead Into Montage",
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "moment_description",
        "why_it_might_lead_into_montage",
        "verification_level",
        "intro_lead_id"
      ],
      "title": "IntroMaterialLeadV2",
      "type": "object"
    },
    "MediaIdentityV2": {
      "additionalProperties": false,
      "properties": {
        "episode_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Number"
        },
        "episode_title": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Title"
        },
        "media_kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "season_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Number"
        },
        "show_or_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Show Or Title",
          "type": "string"
        }
      },
      "required": [
        "media_kind",
        "show_or_title"
      ],
      "title": "MediaIdentityV2",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "TV_EPISODE",
        "TV_SERIES",
        "FILM",
        "TRAILER",
        "OFFICIAL_CLIP"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "NaturalFootageRequestV2": {
      "additionalProperties": false,
      "properties": {
        "alternative": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternative"
        },
        "best": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Best",
          "type": "string"
        },
        "minimum": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Minimum",
          "type": "string"
        },
        "optional_improvement": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Optional Improvement"
        }
      },
      "required": [
        "best",
        "minimum"
      ],
      "title": "NaturalFootageRequestV2",
      "type": "object"
    },
    "OpportunityFocus": {
      "additionalProperties": false,
      "properties": {
        "characters": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Characters",
          "type": "array"
        },
        "relationship_or_topic": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relationship Or Topic",
          "type": "string"
        }
      },
      "required": [
        "relationship_or_topic"
      ],
      "title": "OpportunityFocus",
      "type": "object"
    },
    "OpportunityScoreV2": {
      "additionalProperties": false,
      "properties": {
        "cross_source_agreement": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cross Source Agreement",
          "type": "number"
        },
        "footage_actionability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Footage Actionability",
          "type": "number"
        },
        "independent_source_count": {
          "maximum": 30,
          "minimum": 0,
          "title": "Independent Source Count",
          "type": "integer"
        },
        "release_freshness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Release Freshness",
          "type": "number"
        },
        "scene_specificity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Scene Specificity",
          "type": "number"
        },
        "total": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "release_freshness",
        "cross_source_agreement",
        "scene_specificity",
        "footage_actionability",
        "independent_source_count",
        "total"
      ],
      "title": "OpportunityScoreV2",
      "type": "object"
    },
    "RequestedSourceV2": {
      "additionalProperties": false,
      "properties": {
        "acquisition_effort": {
          "maximum": 5,
          "minimum": 1,
          "title": "Acquisition Effort",
          "type": "integer"
        },
        "asset_kind": {
          "$ref": "#/$defs/SourceAcquisitionKind"
        },
        "characters": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Characters",
          "type": "array"
        },
        "episode_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Number"
        },
        "episode_title": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Episode Title"
        },
        "priority": {
          "maximum": 30,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "purposes": {
          "items": {
            "$ref": "#/$defs/SourcePurpose"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Purposes",
          "type": "array"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/FootageQuoteV2"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "relationship_or_topic": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Or Topic"
        },
        "replaces_required_source_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Replaces Required Source Keys",
          "type": "array"
        },
        "requested_source_id": {
          "format": "uuid4",
          "title": "Requested Source Id",
          "type": "string"
        },
        "scene_or_moment": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Scene Or Moment",
          "type": "string"
        },
        "search_queries": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Search Queries",
          "type": "array"
        },
        "season_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season Number"
        },
        "show_or_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Show Or Title",
          "type": "string"
        },
        "source_key": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Source Key",
          "type": "string"
        },
        "source_quality_summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Quality Summary",
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "format": "uuid4",
            "type": "string"
          },
          "maxItems": 30,
          "title": "Supporting Claim Ids",
          "type": "array"
        },
        "verification_level": {
          "$ref": "#/$defs/FootageVerificationLevel"
        },
        "why_it_matters_emotionally": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Why It Matters Emotionally",
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "priority",
        "acquisition_effort",
        "asset_kind",
        "show_or_title",
        "scene_or_moment",
        "purposes",
        "verification_level",
        "source_quality_summary",
        "why_it_matters_emotionally",
        "search_queries",
        "requested_source_id"
      ],
      "title": "RequestedSourceV2",
      "type": "object"
    },
    "ResearchIntentV2": {
      "additionalProperties": false,
      "properties": {
        "exclusions": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Exclusions",
          "type": "array"
        },
        "focus_terms": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Focus Terms",
          "type": "array"
        },
        "freshness_days": {
          "default": 14,
          "maximum": 90,
          "minimum": 1,
          "title": "Freshness Days",
          "type": "integer"
        },
        "max_results": {
          "default": 5,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Results",
          "type": "integer"
        },
        "media_kinds": {
          "items": {
            "$ref": "#/$defs/MediaKind"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Media Kinds",
          "type": "array"
        },
        "query": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "region": {
          "default": "US",
          "maxLength": 16,
          "minLength": 2,
          "title": "Region",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "spoiler_policy": {
          "$ref": "#/$defs/SpoilerPolicy",
          "default": "CURRENT_EPISODE"
        }
      },
      "required": [
        "query",
        "media_kinds"
      ],
      "title": "ResearchIntentV2",
      "type": "object"
    },
    "ResearchResultStatus": {
      "enum": [
        "OPPORTUNITIES",
        "NO_STRONG_OPPORTUNITY"
      ],
      "title": "ResearchResultStatus",
      "type": "string"
    },
    "SourceAcquisitionKind": {
      "enum": [
        "EPISODE",
        "OFFICIAL_TRAILER",
        "OFFICIAL_CLIP",
        "SCENE_PACK",
        "INDIVIDUAL_SCENES"
      ],
      "title": "SourceAcquisitionKind",
      "type": "string"
    },
    "SourcePurpose": {
      "enum": [
        "INTRO",
        "MONTAGE",
        "PAYOFF",
        "OPTIONAL_CALLBACK"
      ],
      "title": "SourcePurpose",
      "type": "string"
    },
    "SpoilerPolicy": {
      "enum": [
        "AVOID",
        "CURRENT_EPISODE",
        "ALLOW"
      ],
      "title": "SpoilerPolicy",
      "type": "string"
    },
    "TrendOpportunityV2": {
      "additionalProperties": false,
      "properties": {
        "caveats": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Caveats",
          "type": "array"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "creative_hook": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Creative Hook",
          "type": "string"
        },
        "emotional_edit_direction": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Emotional Edit Direction",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/TrustedOpportunityEvidenceReferenceV2"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "evidence_gate": {
          "$ref": "#/$defs/EvidenceGate"
        },
        "focus": {
          "$ref": "#/$defs/OpportunityFocus"
        },
        "footage_request_id": {
          "format": "uuid4",
          "title": "Footage Request Id",
          "type": "string"
        },
        "media_identity": {
          "$ref": "#/$defs/MediaIdentityV2"
        },
        "media_kind": {
          "$ref": "#/$defs/MediaKind"
        },
        "opportunity_id": {
          "format": "uuid4",
          "title": "Opportunity Id",
          "type": "string"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "$ref": "#/$defs/OpportunityScoreV2"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "what_viewers_are_discussing": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "What Viewers Are Discussing",
          "type": "string"
        },
        "why_now": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Why Now",
          "type": "string"
        }
      },
      "required": [
        "opportunity_id",
        "footage_request_id",
        "media_kind",
        "media_identity",
        "title",
        "focus",
        "why_now",
        "what_viewers_are_discussing",
        "creative_hook",
        "emotional_edit_direction",
        "evidence",
        "evidence_gate",
        "confidence",
        "score"
      ],
      "title": "TrendOpportunityV2",
      "type": "object"
    },
    "TrustedOpportunityEvidenceReferenceV2": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "format": "uuid4",
          "title": "Claim Id",
          "type": "string"
        },
        "independence_group": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Independence Group",
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "supports_why_now": {
          "title": "Supports Why Now",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "role",
        "supports_why_now",
        "independence_group"
      ],
      "title": "TrustedOpportunityEvidenceReferenceV2",
      "type": "object"
    }
  },
  "$id": "https://ai-edit-machine.local/contracts/v2/canonical/research-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied_exclusions": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Applied Exclusions",
      "type": "array"
    },
    "footage_requests": {
      "items": {
        "$ref": "#/$defs/FootageRequestV2"
      },
      "maxItems": 10,
      "title": "Footage Requests",
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/ResearchIntentV2"
    },
    "message": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "opportunities": {
      "items": {
        "$ref": "#/$defs/TrendOpportunityV2"
      },
      "maxItems": 10,
      "title": "Opportunities",
      "type": "array"
    },
    "run_id": {
      "format": "uuid4",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResearchResultStatus"
    },
    "warnings": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status",
    "intent",
    "message",
    "generated_at"
  ],
  "title": "ResearchResultV2",
  "type": "object"
}
