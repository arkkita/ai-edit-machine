{
  "$defs": {
    "IntentFacetCategory": {
      "enum": [
        "HARD_CONSTRAINT",
        "SOFT_PREFERENCE",
        "AUDIENCE",
        "PLATFORM_FIT",
        "CREATIVE_EDIT"
      ],
      "title": "IntentFacetCategory",
      "type": "string"
    },
    "IntentFacetSource": {
      "enum": [
        "EXPLICIT",
        "INFERRED_PRIOR"
      ],
      "title": "IntentFacetSource",
      "type": "string"
    },
    "IntentFacetV1": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/IntentFacetCategory"
        },
        "facet_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Facet Id",
          "type": "string"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "rationale": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "removable": {
          "default": true,
          "title": "Removable",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/IntentFacetSource"
        }
      },
      "required": [
        "facet_id",
        "category",
        "label",
        "source",
        "rationale"
      ],
      "title": "IntentFacetV1",
      "type": "object"
    },
    "IntentSearchQuestionV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_goal": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Evidence Goal",
          "type": "string"
        },
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "question_id": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "title": "Question Id",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "query",
        "evidence_goal"
      ],
      "title": "IntentSearchQuestionV1",
      "type": "object"
    },
    "MediaKind": {
      "enum": [
        "TV_EPISODE",
        "TV_SERIES",
        "FILM",
        "TRAILER",
        "OFFICIAL_CLIP"
      ],
      "title": "MediaKind",
      "type": "string"
    },
    "SpoilerPolicy": {
      "enum": [
        "AVOID",
        "CURRENT_EPISODE",
        "ALLOW"
      ],
      "title": "SpoilerPolicy",
      "type": "string"
    },
    "UserIntentInterpretationV1": {
      "additionalProperties": false,
      "properties": {
        "broad_query": {
          "default": false,
          "title": "Broad Query",
          "type": "boolean"
        },
        "clarification_needed": {
          "default": false,
          "title": "Clarification Needed",
          "type": "boolean"
        },
        "clarification_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Reason"
        },
        "direct_tiktok_data_used": {
          "default": false,
          "title": "Direct Tiktok Data Used",
          "type": "boolean"
        },
        "facets": {
          "items": {
            "$ref": "#/$defs/IntentFacetV1"
          },
          "maxItems": 30,
          "title": "Facets",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "search_questions": {
          "items": {
            "$ref": "#/$defs/IntentSearchQuestionV1"
          },
          "maxItems": 20,
          "title": "Search Questions",
          "type": "array"
        },
        "short_form_inference_disclaimer": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Short Form Inference Disclaimer"
        }
      },
      "title": "UserIntentInterpretationV1",
      "type": "object"
    }
  },
  "$id": "https://ai-edit-machine.local/contracts/v2/canonical/research-intent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "exclusions": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Exclusions",
      "type": "array"
    },
    "focus_terms": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Focus Terms",
      "type": "array"
    },
    "freshness_days": {
      "default": 14,
      "maximum": 90,
      "minimum": 1,
      "title": "Freshness Days",
      "type": "integer"
    },
    "interpretation": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserIntentInterpretationV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "max_results": {
      "default": 5,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Results",
      "type": "integer"
    },
    "media_kinds": {
      "items": {
        "$ref": "#/$defs/MediaKind"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Media Kinds",
      "type": "array"
    },
    "query": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "region": {
      "default": "US",
      "maxLength": 16,
      "minLength": 2,
      "title": "Region",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "spoiler_policy": {
      "$ref": "#/$defs/SpoilerPolicy",
      "default": "CURRENT_EPISODE"
    }
  },
  "required": [
    "query",
    "media_kinds"
  ],
  "title": "ResearchIntentV2",
  "type": "object"
}
