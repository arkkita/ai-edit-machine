{
  "$comment": "Provider baseline only; M1 adapter conformance must verify the live API.",
  "$defs": {
    "DossierCharacterV1": {
      "additionalProperties": false,
      "properties": {
        "character_name": {
          "type": "string"
        },
        "performer_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "show_or_title": {
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "verification_status": {
          "$ref": "#/$defs/FootageVerificationLevel"
        }
      },
      "required": [
        "character_name",
        "performer_name",
        "show_or_title",
        "verification_status",
        "supporting_claim_ids"
      ],
      "type": "object"
    },
    "DossierCurrentSourceKind": {
      "enum": [
        "EPISODE",
        "SEASON",
        "TRAILER",
        "OFFICIAL_CLIP",
        "ANNOUNCEMENT",
        "INTERVIEW",
        "ARTICLE",
        "OTHER"
      ],
      "type": "string"
    },
    "DossierCurrentSourceV1": {
      "additionalProperties": false,
      "properties": {
        "episode_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "episode_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "season_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "show_or_title": {
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/DossierCurrentSourceKind"
        },
        "source_title": {
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "verification_status": {
          "$ref": "#/$defs/FootageVerificationLevel"
        }
      },
      "required": [
        "source_kind",
        "show_or_title",
        "source_title",
        "season_number",
        "episode_number",
        "episode_title",
        "verification_status",
        "supporting_claim_ids"
      ],
      "type": "object"
    },
    "DossierEvidenceFactV1": {
      "additionalProperties": false,
      "properties": {
        "supporting_claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "verification_status": {
          "$ref": "#/$defs/FootageVerificationLevel"
        }
      },
      "required": [
        "text",
        "verification_status",
        "supporting_claim_ids"
      ],
      "type": "object"
    },
    "DossierFranchiseConnectionV1": {
      "additionalProperties": false,
      "properties": {
        "characters": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "connected_title": {
          "type": "string"
        },
        "connection_type": {
          "$ref": "#/$defs/LegacyConnectionType"
        },
        "current_title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "verification_status": {
          "$ref": "#/$defs/FootageVerificationLevel"
        }
      },
      "required": [
        "connection_type",
        "current_title",
        "connected_title",
        "characters",
        "description",
        "verification_status",
        "supporting_claim_ids"
      ],
      "type": "object"
    },
    "DossierQuoteLeadV1": {
      "additionalProperties": false,
      "properties": {
        "quote": {
          "$ref": "#/$defs/FootageQuoteV2"
        },
        "source_title": {
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "verification_status": {
          "$ref": "#/$defs/FootageVerificationLevel"
        }
      },
      "required": [
        "quote",
        "source_title",
        "verification_status",
        "supporting_claim_ids"
      ],
      "type": "object"
    },
    "EvidenceRole": {
      "enum": [
        "PRIMARY_WHY_NOW",
        "QUALITATIVE_SIGNAL",
        "QUOTE_PROOF",
        "CONTEXT"
      ],
      "type": "string"
    },
    "FootageQuoteStatus": {
      "enum": [
        "VERIFIED",
        "PARAPHRASE",
        "UNVERIFIED_LEAD"
      ],
      "type": "string"
    },
    "FootageQuoteV2": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "likely_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/FootageQuoteStatus"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "text",
        "speaker",
        "likely_context",
        "claim_id"
      ],
      "type": "object"
    },
    "FootageVerificationLevel": {
      "enum": [
        "VERIFIED",
        "STRONGLY_SUPPORTED",
        "LIKELY_INFERRED",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "LegacyConnectionType": {
      "enum": [
        "NONE",
        "SAME_CHARACTER",
        "SAME_CANONICAL_UNIVERSE",
        "EXPLICIT_CALLBACK",
        "THEMATIC_PARALLEL",
        "ACTOR_CONNECTION_ONLY",
        "FAN_INTERPRETATION",
        "UNSUPPORTED_SPECULATION"
      ],
      "type": "string"
    },
    "OpportunityEvidenceSelectionV2": {
      "additionalProperties": false,
      "description": "Provider selection; trusted code derives independence from the source join.",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "supports_why_now": {
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "role",
        "supports_why_now"
      ],
      "type": "object"
    }
  },
  "$id": "https://ai-edit-machine.local/contracts/v2/provider/openai/fandom-story-dossier-draft.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audience_and_fandom_evidence": {
      "items": {
        "$ref": "#/$defs/DossierEvidenceFactV1"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    },
    "central_relationship": {
      "anyOf": [
        {
          "$ref": "#/$defs/DossierEvidenceFactV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "current_event_or_hook": {
      "$ref": "#/$defs/DossierEvidenceFactV1"
    },
    "current_source": {
      "$ref": "#/$defs/DossierCurrentSourceV1"
    },
    "dossier_key": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/OpportunityEvidenceSelectionV2"
      },
      "maxItems": 60,
      "minItems": 1,
      "type": "array"
    },
    "exact_or_likely_quote": {
      "anyOf": [
        {
          "$ref": "#/$defs/DossierQuoteLeadV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "franchise_connections": {
      "items": {
        "$ref": "#/$defs/DossierFranchiseConnectionV1"
      },
      "maxItems": 20,
      "type": "array"
    },
    "named_characters": {
      "items": {
        "$ref": "#/$defs/DossierCharacterV1"
      },
      "maxItems": 30,
      "minItems": 1,
      "type": "array"
    },
    "relationship_or_character_history": {
      "items": {
        "$ref": "#/$defs/DossierEvidenceFactV1"
      },
      "maxItems": 20,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "show_or_title": {
      "type": "string"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "maxItems": 30,
      "type": "array"
    },
    "why_fans_currently_care": {
      "items": {
        "$ref": "#/$defs/DossierEvidenceFactV1"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "dossier_key",
    "show_or_title",
    "current_event_or_hook",
    "named_characters",
    "central_relationship",
    "current_source",
    "exact_or_likely_quote",
    "franchise_connections",
    "relationship_or_character_history",
    "why_fans_currently_care",
    "audience_and_fandom_evidence",
    "uncertainties",
    "evidence"
  ],
  "type": "object"
}
