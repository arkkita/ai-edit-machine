{
  "$comment": "Provider baseline only; M1 adapter conformance must verify the live API.",
  "$defs": {
    "EvidenceRole": {
      "enum": [
        "PRIMARY_WHY_NOW",
        "QUALITATIVE_SIGNAL",
        "QUOTE_PROOF",
        "CONTEXT"
      ],
      "type": "string"
    },
    "FootageQuoteStatus": {
      "enum": [
        "VERIFIED",
        "PARAPHRASE",
        "UNVERIFIED_LEAD"
      ],
      "type": "string"
    },
    "FootageQuoteV2": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "likely_context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/FootageQuoteStatus"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "text",
        "speaker",
        "likely_context",
        "claim_id"
      ],
      "type": "object"
    },
    "FootageRequestDraftV2": {
      "additionalProperties": false,
      "properties": {
        "alternative_sources": {
          "items": {
            "$ref": "#/$defs/RequestedSourceDraftV2"
          },
          "maxItems": 30,
          "type": "array"
        },
        "concept_key": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "intro_leads": {
          "items": {
            "$ref": "#/$defs/IntroMaterialLeadDraftV2"
          },
          "maxItems": 20,
          "type": "array"
        },
        "minimum_useful_source_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "natural_request": {
          "$ref": "#/$defs/NaturalFootageRequestV2"
        },
        "optional_sources": {
          "items": {
            "$ref": "#/$defs/RequestedSourceDraftV2"
          },
          "maxItems": 30,
          "type": "array"
        },
        "required_sources": {
          "items": {
            "$ref": "#/$defs/RequestedSourceDraftV2"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "schema_version": {
          "const": "2.0.0",
          "type": "string"
        },
        "search_queries": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "type": "array"
        },
        "smallest_useful_set_reason": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "concept_key",
        "summary",
        "natural_request",
        "required_sources",
        "optional_sources",
        "alternative_sources",
        "minimum_useful_source_keys",
        "smallest_useful_set_reason",
        "intro_leads",
        "search_queries",
        "warnings"
      ],
      "type": "object"
    },
    "FootageVerificationLevel": {
      "enum": [
        "VERIFIED",
        "STRONGLY_SUPPORTED",
        "LIKELY_INFERRED",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "IntroMaterialLeadDraftV2": {
      "additionalProperties": false,
      "properties": {
        "moment_description": {
          "type": "string"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/FootageQuoteV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_key": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        "verification_level": {
          "$ref": "#/$defs/FootageVerificationLevel"
        },
        "why_it_might_lead_into_montage": {
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "moment_description",
        "quote",
        "why_it_might_lead_into_montage",
        "verification_level",
        "supporting_claim_ids"
      ],
      "type": "object"
    },
    "LegacyConnectionType": {
      "enum": [
        "NONE",
        "SAME_CHARACTER",
        "SAME_CANONICAL_UNIVERSE",
        "EXPLICIT_CALLBACK",
        "THEMATIC_PARALLEL",
        "ACTOR_CONNECTION_ONLY",
        "FAN_INTERPRETATION",
        "UNSUPPORTED_SPECULATION"
      ],
      "type": "string"
    },
    "NaturalFootageRequestV2": {
      "additionalProperties": false,
      "properties": {
        "alternative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "best": {
          "type": "string"
        },
        "minimum": {
          "type": "string"
        },
        "optional_improvement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "best",
        "alternative",
        "minimum",
        "optional_improvement"
      ],
      "type": "object"
    },
    "OpportunityEvidenceSelectionV2": {
      "additionalProperties": false,
      "description": "Provider selection; trusted code derives independence from the source join.",
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/EvidenceRole"
        },
        "supports_why_now": {
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "role",
        "supports_why_now"
      ],
      "type": "object"
    },
    "RequestedSourceDraftV2": {
      "additionalProperties": false,
      "properties": {
        "acquisition_effort": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        "asset_kind": {
          "$ref": "#/$defs/SourceAcquisitionKind"
        },
        "characters": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array"
        },
        "episode_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "episode_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "purposes": {
          "items": {
            "$ref": "#/$defs/SourcePurpose"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "quote": {
          "anyOf": [
            {
              "$ref": "#/$defs/FootageQuoteV2"
            },
            {
              "type": "null"
            }
          ]
        },
        "relationship_or_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "replaces_required_source_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        "scene_or_moment": {
          "type": "string"
        },
        "search_queries": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "season_number": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "show_or_title": {
          "type": "string"
        },
        "source_key": {
          "pattern": "^[a-z][a-z0-9_]{1,63}$",
          "type": "string"
        },
        "source_quality_summary": {
          "type": "string"
        },
        "supporting_claim_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "type": "array"
        },
        "verification_level": {
          "$ref": "#/$defs/FootageVerificationLevel"
        },
        "why_it_matters_emotionally": {
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "priority",
        "acquisition_effort",
        "asset_kind",
        "show_or_title",
        "season_number",
        "episode_number",
        "episode_title",
        "characters",
        "relationship_or_topic",
        "scene_or_moment",
        "purposes",
        "verification_level",
        "source_quality_summary",
        "supporting_claim_ids",
        "quote",
        "why_it_matters_emotionally",
        "search_queries",
        "replaces_required_source_keys"
      ],
      "type": "object"
    },
    "SourceAcquisitionKind": {
      "enum": [
        "EPISODE",
        "OFFICIAL_TRAILER",
        "OFFICIAL_CLIP",
        "SCENE_PACK",
        "INDIVIDUAL_SCENES"
      ],
      "type": "string"
    },
    "SourcePurpose": {
      "enum": [
        "INTRO",
        "MONTAGE",
        "PAYOFF",
        "OPTIONAL_CALLBACK"
      ],
      "type": "string"
    }
  },
  "$id": "https://ai-edit-machine.local/contracts/v2/provider/openai/editorial-concept-draft.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "central_relationship": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "central_subject": {
      "type": "string"
    },
    "concept_key": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "core_emotion": {
      "type": "string"
    },
    "creative_strength": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "current_event": {
      "type": "string"
    },
    "dossier_key": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "type": "string"
    },
    "ending_or_payoff": {
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/OpportunityEvidenceSelectionV2"
      },
      "maxItems": 30,
      "minItems": 1,
      "type": "array"
    },
    "footage_feasibility": {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
    },
    "footage_request": {
      "$ref": "#/$defs/FootageRequestDraftV2"
    },
    "intro_leads": {
      "items": {
        "$ref": "#/$defs/IntroMaterialLeadDraftV2"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
    },
    "known_uncertainties": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "type": "array"
    },
    "legacy_connection_type": {
      "$ref": "#/$defs/LegacyConnectionType"
    },
    "legacy_or_contextual_connection": {
      "type": "string"
    },
    "montage_arc": {
      "items": {
        "type": "string"
      },
      "maxItems": 6,
      "minItems": 3,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "song_handoff_idea": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "verification_status": {
      "$ref": "#/$defs/FootageVerificationLevel"
    },
    "viewer_hook": {
      "type": "string"
    },
    "why_fans_may_care": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "concept_key",
    "dossier_key",
    "title",
    "central_subject",
    "central_relationship",
    "core_emotion",
    "viewer_hook",
    "why_fans_may_care",
    "current_event",
    "legacy_or_contextual_connection",
    "legacy_connection_type",
    "intro_leads",
    "song_handoff_idea",
    "montage_arc",
    "ending_or_payoff",
    "evidence",
    "verification_status",
    "creative_strength",
    "footage_feasibility",
    "known_uncertainties",
    "footage_request"
  ],
  "type": "object"
}
