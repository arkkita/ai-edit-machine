{
  "$defs": {
    "EvidenceSourceType": {
      "enum": [
        "PRIMARY_RELEASE",
        "OFFICIAL_CLIP",
        "PLATFORM_SIGNAL",
        "ARTICLE",
        "METADATA"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "ExcerptType": {
      "enum": [
        "SHORT_QUOTE",
        "PARAPHRASE",
        "UNVERIFIED_QUOTE_LEAD"
      ],
      "title": "ExcerptType",
      "type": "string"
    },
    "VerificationState": {
      "enum": [
        "PRIMARY_VERIFIED",
        "SECONDARY_CORROBORATED",
        "LEAD_ONLY",
        "STALE",
        "RETRACTED"
      ],
      "title": "VerificationState",
      "type": "string"
    }
  },
  "$id": "https://ai-edit-machine.local/contracts/v1/canonical/evidence-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author_or_channel": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Author Or Channel"
    },
    "canonical_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Canonical Url",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "event_or_release_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Event Or Release At"
    },
    "evidence_id": {
      "format": "uuid4",
      "title": "Evidence Id",
      "type": "string"
    },
    "excerpt": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Excerpt",
      "type": "string"
    },
    "excerpt_type": {
      "$ref": "#/$defs/ExcerptType"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "page_published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Published At"
    },
    "policy_class": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Policy Class",
      "type": "string"
    },
    "provider": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_record_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Record Id"
    },
    "purge_due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purge Due At"
    },
    "query": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "refresh_due_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Refresh Due At"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Created At"
    },
    "source_type": {
      "$ref": "#/$defs/EvidenceSourceType"
    },
    "source_updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Updated At"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "verification": {
      "$ref": "#/$defs/VerificationState"
    },
    "window_end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window End"
    },
    "window_start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Start"
    }
  },
  "required": [
    "evidence_id",
    "provider",
    "source_type",
    "canonical_url",
    "title",
    "excerpt_type",
    "excerpt",
    "verification",
    "retrieved_at",
    "query",
    "confidence",
    "policy_class",
    "content_sha256"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}
